# Genopoisk Environment Variables (template)
# Copy to .env and fill. NEVER commit .env to GitHub!
# These values must be set in Vercel Project Settings > Environment Variables.

# Telegram Bot
TG_BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789

# Notify-commit endpoint (GitHub Action → Vercel → Telegram admins)
# Generate a random 32+ char string. Set the SAME value in:
#   1. Vercel env vars (NOTIFY_TOKEN)
#   2. GitHub repo Settings → Secrets → NOTIFY_TOKEN
#   3. GitHub repo Settings → Secrets → NOTIFY_URL = https://genopoisk.vercel.app/api/notify-commit
NOTIFY_TOKEN=generate_a_long_random_secret_string_here

# Vercel API (for /status and /redeploy)
VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=prj_xxx
VERCEL_TEAM_ID=team_xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxx

# Telegram OIDC
TELEGRAM_CLIENT_ID=123456789
TELEGRAM_CLIENT_SECRET=xxx
TELEGRAM_REDIRECT_URI=https://genopoisk.vercel.app/api/auth/telegram/callback

# Site URL
SITE_URL=https://genopoisk.vercel.app
